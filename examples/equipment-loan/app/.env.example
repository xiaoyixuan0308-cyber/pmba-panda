# Copy to .env.local and fill in. `npm run dev` works without it.

# Signs the login session. Required when running the built app (`npm run build && npm start`):
# without a value of at least 32 characters the app refuses to start.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: where the SQLite database lives (default: data/app.db).
# DB_FILE=data/app.db
